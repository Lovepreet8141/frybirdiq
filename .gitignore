# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Exported contact lists are personal data.
*.csv

# The uploaded Frybird IQ repo, kept for reference while its costing engine
# is ported into src/. Not part of this build.
frybird-iq/

# The purchased Shadcn UI Kit dashboard source, kept at the repo root for
# reference (its blocks are re-composed over our own primitives, never copied
# in). Licensed, and carries its own node_modules — never committed.
shadcn-ui-kit-dashboard/
