# Copy to .env.local and fill in. Never commit .env.local.
#
# Create a Supabase project at https://supabase.com/dashboard, then find these
# under Project Settings → API and Project Settings → Database.

# Public — safe in the browser bundle, subject to row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. The service role bypasses row-level security entirely.
# Never expose it to the client, never commit it. BUILD-PLAN.md §46.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# The site's own public origin, e.g. https://frybirdiq.tech — used to build the
# order links in WhatsApp messages. Read at runtime, not inlined at build time,
# so it belongs in the server's env file rather than in the build. Without it,
# sending a message fails loudly instead of shipping a localhost link.
SITE_URL=

# Scheduled jobs (IQ). The shared secret a local systemd timer presents to
# POST /api/jobs/<job>. Unset means the job routes stay dormant and answer 404.
# At least 32 characters; generate one, never reuse another secret. To rotate,
# move the current value to JOB_SECRET_PREVIOUS, set a new JOB_SECRET, update
# the timer's header file, then clear JOB_SECRET_PREVIOUS.
JOB_SECRET=
JOB_SECRET_PREVIOUS=

# Optional until the phase that needs them.
# AI — Phase 11.
ANTHROPIC_API_KEY=

# Payments — Phase 2. Razorpay covers UPI, cards and netbanking behind the
# PaymentProvider interface. BUILD-PLAN.md §3.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Paytm: leave all blank until the owner has credentials (docs/PAYTM-PROVIDER.md). PAYTM_ENV is staging or production.
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=
PAYTM_ENV=
PAYTM_CALLBACK_URL=
# Leave blank. "true" lets staging credentials run on the live site, ONLY for the sandbox proof.
PAYTM_ALLOW_STAGING=

# Purchased Shadcn UI Kit registry (@shadcnuikit in components.json). The
# licence token from https://shadcnuikit.com/dashboard/licences; the shadcn
# CLI and MCP server expand ${REGISTRY_TOKEN} from this file. Development
# tooling only — never read by the app, never needed on the server.
REGISTRY_TOKEN=

# Signs the frybird_contact cookie and binds order ownership to the orders this browser placed (cookie-sign-1). Leave unset locally. On the server: 32+ printable characters generated with openssl on the VPS, never printed or committed. A malformed value fails closed (no remembered contact), it never breaks a page.
COOKIE_SECRET=
