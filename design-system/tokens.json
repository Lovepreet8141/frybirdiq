{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "FRYBIRD IQ",
    "version": "0.1.0",
    "note": "Machine-readable mirror of MASTER.md. The CSS custom properties in src/app/globals.css are generated from these values; if the two disagree, MASTER.md wins and both should be corrected."
  },
  "color": {
    "brand": {
      "red": {
        "value": "#D92B2B",
        "note": "Brand red. Fills and display type. 4.15:1 on cream \u2014 never small text."
      },
      "redDeep": {
        "value": "#A81D1D",
        "note": "The shadow under a pressed button."
      },
      "redInk": {
        "value": "#B81E1E",
        "note": "Red for small text. 5.55:1 on cream."
      },
      "cream": {
        "value": "#F5EDD8",
        "note": "Page background."
      },
      "creamHi": {
        "value": "#FBF8F1",
        "note": "Cards and raised panels."
      },
      "cream2": {
        "value": "#EAE0C8",
        "note": "Muted fills, the hero watermark."
      },
      "ink": {
        "value": "#2C211B",
        "note": "Body copy and the footer ground."
      },
      "inkDeep": {
        "value": "#1A120F"
      },
      "muted": {
        "value": "#796958",
        "note": "Secondary text. 4.53:1 on cream \u2014 the design's #7C6C5A was 4.33 and failed."
      },
      "borderStrong": {
        "value": "#918774",
        "note": "3.04:1 \u2014 for a border that is itself the control."
      }
    },
    "semantic": {
      "background": {
        "value": "{color.brand.charred}"
      },
      "foreground": {
        "value": "{color.brand.cream}"
      },
      "surface": {
        "value": "{color.brand.charred2}"
      },
      "surfaceElevated": {
        "value": "#361009"
      },
      "surfaceMuted": {
        "value": "#180504"
      },
      "mutedForeground": {
        "value": "{color.brand.ash}"
      },
      "border": {
        "value": "rgba(245, 237, 216, 0.14)"
      },
      "borderStrong": {
        "value": "rgba(245, 237, 216, 0.28)"
      },
      "primary": {
        "value": "{color.brand.amber}"
      },
      "onPrimary": {
        "value": "{color.brand.charred}"
      },
      "secondary": {
        "value": "{color.brand.ember}"
      },
      "onSecondary": {
        "value": "{color.brand.cream}"
      },
      "accent": {
        "value": "{color.brand.amber}"
      },
      "destructive": {
        "value": "{color.brand.ember}"
      },
      "onDestructive": {
        "value": "{color.brand.cream}"
      },
      "success": {
        "value": "#3F9D52",
        "note": "Status only, never decoration. A ready ticket cannot be brand red."
      },
      "onSuccess": {
        "value": "#0B1A0E"
      },
      "warning": {
        "value": "{color.brand.amber}"
      },
      "ring": {
        "value": "{color.brand.amber}"
      }
    },
    "contrast": {
      "note": "Measured, not assumed. See MASTER.md \u00a72.",
      "creamOnCharred": 16.49,
      "creamOnCharred2": 15.59,
      "amberOnCharred": 9.2,
      "ashOnCharred": 8.39,
      "charredOnAmber": 9.2,
      "creamOnEmber": 5.14,
      "emberOnCharred": 3.21
    },
    "staff": {
      "ember": {
        "value": "#C21F11"
      },
      "charred": {
        "value": "#1F0705",
        "note": "Staff page background. Kitchen screens stay dark."
      },
      "charred2": {
        "value": "#2B0B07"
      },
      "amber": {
        "value": "#F2A324",
        "note": "The staff accent. Actions only."
      },
      "ash": {
        "value": "#C3A597"
      },
      "cream": {
        "value": "#F5EDD8"
      }
    },
    "chart": {
      "note": "Staff surface only. MASTER.md §5 'Charts'. chart-1 is the neutral a data series is drawn in; red is last and only for a series that is an alert.",
      "1": { "value": "#55504A", "note": "Ink grey — the default series." },
      "2": { "value": "#0F7B4F", "note": "Success — status only." },
      "3": { "value": "#726C63", "note": "Muted grey — a quieter second series." },
      "4": { "value": "#C2410C", "note": "Warning — over target, late, at risk." },
      "5": { "value": "#D92B2B", "note": "Red — an alert series, nothing else." }
    },
    "order": {
      "note": "Staff surface only. Order type and status tints for the orders list — MASTER.md §5 'Order tints'. Each ink on its ground is checked AA by scripts/check-contrast.py.",
      "type": {
        "dineIn": { "ground": "#F1E6FF", "ink": "#4C1D95", "line": "#E3D2FA", "swatch": "#7C3AED" },
        "takeaway": { "ground": "#FFEDD5", "ink": "#7C2D12", "line": "#FBD9B5", "swatch": "#EA580C" },
        "delivery": { "ground": "#E0ECFF", "ink": "#1E3A8A", "line": "#C7D8FA", "swatch": "#2563EB" },
        "online": { "ground": "#DCFCE7", "ink": "#14532D", "line": "#BBF0CD", "swatch": "#16A34A" }
      },
      "status": {
        "new": { "dot": "#DC2626", "ground": "#FEF2F2", "ink": "#991B1B" },
        "accepted": { "dot": "#2563EB", "ground": "#EFF6FF", "ink": "#1E40AF" },
        "cooking": { "dot": "#D97706", "ground": "#FFFBEB", "ink": "#92400E" },
        "ready": { "dot": "#16A34A", "ground": "#F0FDF4", "ink": "#166534" },
        "outForDelivery": { "dot": "#0D9488", "ground": "#F0FDFA", "ink": "#115E59" }
      },
      "lateLine": { "value": "#F5B8B0", "note": "Border of a row past its promised time." }
    },
    "promo": {
      "note": "Staff surface only. Promotion status tints — MASTER.md §5. Each ink on its ground is checked AA by scripts/check-contrast.py.",
      "status": {
        "live": { "ground": "#F5EDD8", "ink": "#7A3B00", "line": "#C9A227" },
        "paused": { "ground": "#FDECE4", "ink": "#C2410C", "line": "#D98282" },
        "draft": { "ground": "#EEEEEE", "ink": "#555555", "line": "#CFD1D4" }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "value": "Archivo, 'Helvetica Neue', Arial, sans-serif"
      },
      "body": {
        "value": "Manrope, 'Helvetica Neue', Arial, sans-serif"
      },
      "devanagari": {
        "value": "'Baloo 2', Manrope, sans-serif"
      }
    },
    "size": {
      "display": {
        "value": "clamp(3rem, 8vw, 6rem)"
      },
      "h1": {
        "value": "clamp(2rem, 4vw, 3rem)"
      },
      "h2": {
        "value": "clamp(1.5rem, 3vw, 2rem)"
      },
      "h3": {
        "value": "1.25rem"
      },
      "bodyLarge": {
        "value": "1.125rem"
      },
      "body": {
        "value": "1rem"
      },
      "small": {
        "value": "0.875rem"
      },
      "caption": {
        "value": "0.75rem"
      },
      "label": {
        "value": "0.75rem"
      },
      "price": {
        "value": "clamp(1rem, 1.5vw, 1.25rem)"
      },
      "kpi": {
        "value": "clamp(2rem, 4vw, 2.75rem)"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 0.95,
      "display": 1.05,
      "heading": 1.15,
      "snug": 1.25,
      "body": 1.55,
      "dense": 1.45
    },
    "letterSpacing": {
      "display": "-0.02em",
      "heading": "-0.01em",
      "body": "0",
      "label": "0.08em"
    },
    "numeric": {
      "value": "tabular-nums",
      "note": "Required on every price, total, KPI and table column."
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem",
    "gutter": {
      "value": "clamp(1.25rem, 5vw, 4.5rem)"
    }
  },
  "density": {
    "customer": {
      "sectionGap": "clamp(3rem, 8vw, 6rem)",
      "stackGap": "1.5rem"
    },
    "dashboard": {
      "sectionGap": "2rem",
      "stackGap": "1rem"
    },
    "pos": {
      "sectionGap": "1rem",
      "stackGap": "0.5rem"
    }
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "shadow": {
    "note": "Elevation on a dark ground comes from surface lightness first. Shadows are for floating things only.",
    "raised": "none",
    "overlay": "0 8px 32px rgba(0, 0, 0, 0.48)",
    "dialog": "0 24px 64px rgba(0, 0, 0, 0.6)"
  },
  "motion": {
    "duration": {
      "micro": "120ms",
      "standard": "200ms",
      "entrance": "320ms",
      "hero": "560ms",
      "posMax": {
        "value": "120ms",
        "note": "Hard ceiling. Nothing on the POS exceeds this."
      }
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "spring": {
        "type": "spring",
        "stiffness": 420,
        "damping": 32
      }
    }
  },
  "target": {
    "minimum": {
      "value": "44px",
      "note": "Customer surfaces. WCAG plus iOS."
    },
    "pos": {
      "value": "56px",
      "note": "Staff moving fast with wet hands."
    },
    "gap": {
      "value": "8px"
    }
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "header": 20,
    "drawer": 30,
    "dialog": 40,
    "toast": 50
  },
  "breakpoint": {
    "sm": "375px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  }
}
