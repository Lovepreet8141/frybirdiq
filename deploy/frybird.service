# systemd unit for the FRYBIRD ordering app.
#
#   sudo cp deploy/frybird.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now frybird
#
# systemd rather than pm2: it is already on the box, it restarts the app on
# boot and on crash without another daemon to keep alive, and its logs go to
# journalctl with everything else.

[Unit]
Description=FRYBIRD ordering app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frybird
WorkingDirectory=/var/www/frybird

# The standalone build runs plain node. No pnpm, no next CLI, no dev
# dependencies on the server at all.
ExecStart=/usr/bin/node server.js

# Secrets live in a root-owned file the service user can read, never in this
# unit — a unit file is world-readable and ends up in git.
EnvironmentFile=/etc/frybird/env

Environment=NODE_ENV=production
Environment=PORT=3000
# Bind to loopback only. nginx is the only thing that should reach it; a
# process listening on 0.0.0.0 is reachable directly on the public IP,
# bypassing TLS and every header nginx sets.
Environment=HOSTNAME=127.0.0.1

Restart=always
RestartSec=5

# Hardening. Customer uploads go to Supabase Storage, so the app has no
# business writing anywhere on this filesystem except Next's own generated
# output. Two paths, not one — the first found this way: Next keeps its
# optimised-image and prerender cache under .next/cache, and with the whole
# tree read-only it retried and failed on every single image request — EROFS
# in the log, and every one of the menu photos re-encoded per request on a
# one-core box. The second found the same way, later: a static route like
# `src/app/icon.svg` gets a cached response file under .next/server/app/ (as
# `icon.svg.body`/`.meta`) that Next writes to at request time even though
# the build already shipped one — same EROFS, same fix, different file.
# Broader than a single filename on purpose: whatever the next special route
# type needs to write in this directory, this already covers it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The leading "-" means a missing path is tolerated rather than fatal. Without
# it, a deploy that removes this directory leaves systemd unable to build the
# namespace at all: the unit fails with 226/NAMESPACE and the site returns 502
# with nothing in the application log to explain it.
ReadWritePaths=-/var/www/frybird/.next/cache
ReadWritePaths=-/var/www/frybird/.next/server/app

StandardOutput=journal
StandardError=journal
SyslogIdentifier=frybird

[Install]
WantedBy=multi-user.target
