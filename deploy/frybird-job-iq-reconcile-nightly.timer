# Starts frybird-job@iq-reconcile-nightly.service once a day at 21:00:00 (02:30 IST).
# Reconcile yesterday's payments and GST against the ledger (IQ-2, SELECT-only), 02:30 IST, after the facts job.
# OnCalendar must stay byte-for-byte the JOB_REGISTRY["iq-reconcile-nightly"].onCalendarUtc
# string in src/lib/jobs/registry.ts; src/lib/jobs/registry.test.ts reads this
# file and fails the build the moment the two drift.
#
#   cp deploy/frybird-job-iq-reconcile-nightly.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now frybird-job-iq-reconcile-nightly.timer
#   systemctl list-timers frybird-job-iq-reconcile-nightly.timer
#
# Off: systemctl disable --now frybird-job-iq-reconcile-nightly.timer && systemctl stop 'frybird-job@iq-reconcile-nightly.service' (docs/DEPLOY.md 9.4).

[Unit]
Description=Run the FRYBIRD IQ reconciliation nightly

[Timer]
# The target is the templated instance, not this timer's own base name.
Unit=frybird-job@iq-reconcile-nightly.service
OnCalendar=*-*-* 21:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
